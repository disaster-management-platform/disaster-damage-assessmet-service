/subsystem=datasources/data-source=DamageAssessment:add(jndi-name=java:jboss/datasources/DamageAssessment,driver-name=postgresql-42.7.7.jar,connection-url="jdbc:postgresql://${env.DAMAGE_DB_HOST}:${env.DAMAGE_DB_PORT:5432}/${env.DAMAGE_DB_NAME:postgres}?sslmode=verify-full&sslrootcert=${env.DAMAGE_DB_CA}",user-name="${env.DAMAGE_DB_USER}",password="${env.DAMAGE_DB_PASSWORD}",min-pool-size=0,max-pool-size=8,blocking-timeout-wait-millis=5000,query-timeout=10,jta=true,enabled=true)
