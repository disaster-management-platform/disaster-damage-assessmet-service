    "/api/evaluaciones": {
      "get": {
        "summary": "Snapshot completo actual por desastre",
        "responses": {
          "200": {
            "description": "Éxito o repetición idempotente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Autenticación requerida"
          },
          "403": {
            "description": "Acceso insuficiente"
          },
          "404": {
            "description": "No encontrado o no visible"
          },
          "409": {
            "description": "Conflicto de identidad, activo o versión"
          },
          "413": {
            "description": "Cuerpo mayor de 256 KiB"
          },
          "422": {
            "description": "Regla de negocio incumplida"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        },
        "parameters": [
          {
            "name": "disasterId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "summary": "Crear Draft; actor y organización del JWT",
        "responses": {
          "200": {
            "description": "Éxito o repetición idempotente",
            "content": {
