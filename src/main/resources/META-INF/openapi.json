    "/api/evaluaciones/{id}/historial": {
      "get": {
        "summary": "Snapshots históricos inmutables con actor, fecha, acción, revisión y versión",
        "responses": {
          "200": {
            "description": "Éxito o repetición idempotente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "revision": {
                        "type": "integer"
                      },
                      "version": {
                        "type": "integer"
                      },
                      "actor": {
                        "type": "string",
                        "nullable": true
                      },
                      "recordedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "action": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string",
                        "nullable": true
                      },
                      "snapshot": {
                        "type": "string",
                        "description": "JSON inmutable de la evaluación en esa versión"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Autenticación requerida"
          },
          "403": {
            "description": "Acceso insuficiente"
          },
          "404": {
            "description": "No encontrado o no visible"
          },
          "409": {
            "description": "Conflicto de identidad, activo o versión"
          },
          "413": {
            "description": "Cuerpo mayor de 256 KiB"
          },
          "422": {
            "description": "Regla de negocio incumplida"
          },
          "503": {
            "description": "Dependencia no disponible"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/evaluaciones/{id}/evidencias": {
      "get": {
        "summary": "Evidencias autorizadas: GET /api/evaluaciones/{id}/evidencias",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadatos; intención incluye uploadUrl, uploadExpiresAt, method PUT y headers. Descarga devuelve url y expiresAt (60 segundos).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Evidence"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Autenticación requerida"
          },
          "403": {
            "description": "Permisos insuficientes"
          },
          "404": {
            "description": "No visible"
          },
          "409": {
            "description": "UUID, revisión o confirmación concurrente; reintentar la misma identidad"
          },
          "413": {
            "description": "Tamaño excedido"
          },
          "422": {
            "description": "Archivo rechazado, expirado o aún inexistente"
          },
          "429": {
            "description": "Capacidad de intenciones alcanzada"
          },
          "503": {
            "description": "Storage no disponible o concurrencia agotada"
          }
        }
      },
      "post": {
        "summary": "Evidencias autorizadas: POST /api/evaluaciones/{id}/evidencias",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadatos; intención incluye uploadUrl, uploadExpiresAt, method PUT y headers. Descarga devuelve url y expiresAt (60 segundos).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Evidence"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "uploadUrl": {
                          "type": "string",
                          "format": "uri"
                        },
                        "uploadExpiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "method": {
                          "type": "string",
                          "enum": [
                            "PUT"
                          ]
                        },
                        "headers": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "Autenticación requerida"
          },
          "403": {
            "description": "Permisos insuficientes"
          },
          "404": {
            "description": "No visible"
          },
          "409": {
            "description": "UUID, revisión o confirmación concurrente; reintentar la misma identidad"
          },
          "413": {
            "description": "Tamaño excedido"
          },
          "422": {
            "description": "Archivo rechazado, expirado o aún inexistente"
          },
          "429": {
            "description": "Capacidad de intenciones alcanzada"
          },
          "503": {
            "description": "Storage no disponible o concurrencia agotada"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvidenceUpload"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "size": {
                    "type": "integer"
                  },
                  "sha256": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "description": "JSON: crear intención durable y transferir directamente con PUT al uploadUrl, Content-Type indicado y x-upsert:false; confirmar después. La vigencia efectiva proviene del token del proveedor, normalmente 2 horas. Multipart transmite y confirma usando el mismo sistema. Nunca almacenar URLs como referencias."
      }
    },
