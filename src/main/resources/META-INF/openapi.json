  "components": {
    "schemas": {
      "EvaluationInput": {
        "type": "object",
        "required": [
          "assetId",
          "assetTypeId",
          "damageCategoryId",
          "evaluatedAt",
          "location",
          "description",
          "evidence",
          "budget"
        ],
        "properties": {
          "disasterId": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "assetId": {
            "type": "string",
            "maxLength": 200
          },
          "assetTypeId": {
            "type": "string",
            "maxLength": 120
          },
          "damageCategoryId": {
            "type": "string",
            "maxLength": 120
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          },
          "geometry": {
            "type": "object",
            "nullable": true,
            "description": "GeoJSON Point, Polygon o MultiPolygon WGS84; máximo 2000 posiciones y 64 KiB."
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "budget": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.01,
            "description": "COP; hasta 17 posiciones enteras y 2 decimales."
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Obligatorio en PUT; no se utiliza en POST."
          }
        },
        "example": {
          "disasterId": null,
          "assetId": "bridge-001",
          "assetTypeId": "Bridge",
          "damageCategoryId": "Severe",
          "evaluatedAt": "2026-11-18T00:00:00Z",
          "location": "Zona Norte",
          "latitude": 4.7,
          "longitude": -74,
          "geometry": null,
          "description": "Daño estructural",
          "evidence": [],
          "budget": 150000.0
        }
      },
      "Evaluation": {
        "type": "object",
        "required": [
          "evaluationId",
          "assetId",
          "assetType",
          "evaluatedAt",
          "evaluator",
          "organization",
          "location",
          "damageLevel",
          "description",
          "evidence",
          "status",
          "budget",
          "revision",
          "version"
        ],
        "properties": {
          "disasterId": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "assetId": {
            "type": "string",
            "maxLength": 200
          },
          "assetTypeId": {
            "type": "string",
            "maxLength": 120
          },
          "damageCategoryId": {
            "type": "string",
            "maxLength": 120
          },
          "evaluatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "type": "string",
            "maxLength": 200
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "nullable": true
          },
          "geometry": {
            "type": "object",
            "nullable": true,
            "description": "GeoJSON Point, Polygon o MultiPolygon WGS84; máximo 2000 posiciones y 64 KiB."
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "budget": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.01,
            "description": "COP; hasta 17 posiciones enteras y 2 decimales."
          },
          "evaluationId": {
            "type": "string",
            "format": "uuid"
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "assetType": {
            "type": "string"
          },
          "evaluator": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "damageLevel": {
            "type": "string",
            "enum": [
              "None",
              "Minor",
              "Moderate",
              "Severe",
              "Destroyed"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Validated",
              "Rejected"
            ],
            "description": "Esta iteración solo crea y edita Draft."
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "required": [
          "schemaVersion",
          "disasterId",
          "evaluations"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "disasterId": {
            "type": "integer"
          },
          "evaluations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evaluation"
            }
          }
        }
      },
      "Association": {
        "type": "object",
        "required": [
          "disasterId",
          "expectedVersion"
        ],
        "properties": {
          "disasterId": {
            "type": "integer",
            "minimum": 1
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CatalogInput": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,120}$"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "damageLevel": {
            "type": "string",
            "enum": [
              "None",
              "Minor",
              "Moderate",
              "Severe",
              "Destroyed"
            ],
            "description": "Obligatorio en categoría."
          },
          "active": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
      "Catalogs": {
        "type": "object",
        "properties": {
          "assetTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogInput"
            }
          },
          "damageCategories": {
            "type": "array",
